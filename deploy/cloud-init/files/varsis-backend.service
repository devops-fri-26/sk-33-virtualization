[Unit]
Description=Varsis backend (FastAPI)
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
User=varsis
Group=varsis
WorkingDirectory=/opt/varsis/backend
EnvironmentFile=/etc/varsis/backend.env
# Only on localhost: Caddy is the only way in
ExecStart=/opt/varsis/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3

# Sandboxing: read-only system, writes only to the data folder.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/varsis

[Install]
WantedBy=multi-user.target
