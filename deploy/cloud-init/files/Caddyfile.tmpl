# Caddy: HTTPS, static frontend, /api proxy. __SITE__, __TLS__ and __FRAMED__ are filled in by start-caddy.sh.
__SITE__ {
	__TLS__
	encode zstd gzip

	# This block is applied last (the "-Server" deletion makes Caddy defer it), so nothing here can be
	# overridden per path. X-Frame-Options is therefore separate, with a matcher.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		-Server
	}
	# Every path, except /mailpit* when MAILPIT=true (it shows mails in a same-origin iframe).
	@framed __FRAMED__
	header @framed X-Frame-Options DENY

	# The backend reads JSON bodies into memory: keep them small. Only uploads are big.
	@upload path /api/upload
	request_body @upload {
		max_size 2GB
	}
	@small not path /api/upload
	request_body @small {
		max_size 1MB
	}

	# Mailpit inbox when MAILPIT=true, otherwise an empty file (written by start-caddy.sh).
	import /etc/caddy/mailpit.caddy

	handle /api/* {
		reverse_proxy 127.0.0.1:8000 {
			# The backend's rate limits key on this header; overwrite whatever the client sent.
			header_up X-Real-IP {remote_host}
			flush_interval -1
		}
	}

	handle {
		root * /var/www/varsis
		try_files {path} /index.html
		file_server
	}

	# One JSON line per request. Email links carry a token (/verify?token=…, /reset-password?token=…), which would
	# otherwise be in the log twice: in the URL, and in the Referer of the files that page loads. So the token in the
	# URL is replaced and the Referer header isn't logged.
	log {
		output file /var/log/caddy/varsis-access.log
		format filter {
			wrap json
			request>uri query {
				replace token REDACTED
			}
			request>headers>Referer delete
		}
	}
}
