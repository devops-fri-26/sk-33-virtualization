[Unit]
Description=Mailpit (test mail catcher)
After=network.target

[Service]
# DynamicUser: systemd creates a throwaway user for the service; StateDirectory is the one folder it may write.
DynamicUser=true
StateDirectory=mailpit
# SMTP for the backend on 1025, web UI on 8025 (served by Caddy at /mailpit/). Both on localhost only.
ExecStart=/usr/local/bin/mailpit --listen 127.0.0.1:8025 --smtp 127.0.0.1:1025 --webroot /mailpit/ --database /var/lib/mailpit/mailpit.db
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
