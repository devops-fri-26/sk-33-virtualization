# -*- mode: ruby -*-
# vi: set ft=ruby :

# Varsis development VM. Run from this folder:
#   vagrant up                                   (first time: ~3-5 min)
#   ADMIN_EMAILS=you@example.com vagrant up      (that account becomes admin)
# Then open https://localhost:8443 (self-signed certificate) and https://localhost:8443/mailpit/ (sent mails).
# Development only: self-signed certificate, Mailpit instead of a mail provider, reachable only from this computer.

# The "2" is the configuration version of the Vagrantfile format.
Vagrant.configure("2") do |config|
  # Base image ("box"): Ubuntu 24.04 built from Ubuntu's official cloud images. Unlike bento/ubuntu-24.04 it is
  # published for libvirt, the provider used here.
  config.vm.box = "cloud-image/ubuntu-24.04"

  config.vm.hostname = "varsis-dev"

  # https://localhost:8443 on the host -> nginx on port 443 in the VM. host_ip 127.0.0.1: only this computer can
  # connect, not the rest of the network.
  config.vm.network "forwarded_port", guest: 443, host: 8443, host_ip: "127.0.0.1"

  # The provisioning scripts (this folder) and the app's code (the repository, two folders up) are copied into the
  # VM with rsync on `vagrant up`, `vagrant reload` and `vagrant rsync`. rsync instead of a live share: libvirt's
  # default share is NFS, which needs an NFS server and root on the host.
  config.vm.synced_folder ".", "/vagrant", type: "rsync"
  config.vm.synced_folder "../..", "/varsis-src", type: "rsync",
    rsync__exclude: [".git/", ".env", "node_modules/", ".venv/", "dist/", "__pycache__/", "deploy/"]

  # libvirt runs the VM with QEMU/KVM. 2 GB of memory: the frontend build needs it.
  config.vm.provider "libvirt" do |lv|
    lv.cpus = 2
    lv.memory = 2048
    lv.machine_virtual_size = 20 # GB; the box's disk is smaller and is grown to this at first boot
  end

  # Provisioning: one script per step, run as root in this order on the first `vagrant up` (again with
  # `vagrant provision`). Every script can run again without breaking what it set up before.
  config.vm.provision "shell", name: "varsis",
    env: { "ADMIN_EMAILS" => ENV.fetch("ADMIN_EMAILS", "admin@example.com") },
    inline: <<-SHELL
    set -euo pipefail
    cd /vagrant/scripts

    # apt packages: nginx, PostgreSQL, Python 3.13, Node.js, ufw, ...
    bash install-dependencies.sh

    # varsis system user, app and data folders
    bash create-users-and-folders.sh

    # PostgreSQL role and database (login without password, over the local socket)
    bash setup-postgresql.sh

    # /etc/varsis/backend.env and the generated SECRET_KEY
    bash configuration.sh

    # Copy the code to /opt/varsis, install the Python packages from uv.lock
    bash setup-backend.sh

    # Build the Vue app into /var/www/varsis
    bash build-frontend.sh

    # Mailpit: catches every mail the app sends
    bash setup-mailpit.sh

    # systemd services for the backend and Mailpit, then wait until the backend answers
    bash services.sh

    # nginx with HTTPS (self-signed) and the firewall
    bash start-nginx.sh

    echo "Provisioning complete: https://localhost:8443 (mails: https://localhost:8443/mailpit/)"
  SHELL
end
