# Copy to .env and adjust. Hostnames are the docker compose service names.
# Generate both secrets with: openssl rand -hex 32
# (docker compose builds DATABASE_URL from POSTGRES_PASSWORD; the backend refuses to start with a weak SECRET_KEY.)
POSTGRES_PASSWORD=
SECRET_KEY=
# The public address (https in production). Email links and the secure cookie use it.
APP_URL=http://localhost:8080

# Comma-separated. These accounts are admins and skip admin approval (they still verify their email).
ADMIN_EMAILS=
# Where the app keeps its data (database, music, covers, torrent configs), one folder each.
DATA_DIR=/varsis

# Upload space of each new user, in GB. Admins can change it per user on the admin page.
DEFAULT_QUOTA_GB=10

# Dev: Mailpit catches all mail (UI on :8025). Prod: put real SMTP values here, with SMTP_TLS=true
# (the backend refuses to start with SMTP_USER set and no TLS: the password would be sent as plain text).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=varsis@localhost
SMTP_TLS=false

PROWLARR_URL=http://prowlarr:9696
PROWLARR_API_KEY=
QBIT_URL=http://qbittorrent:8081
QBIT_USER=admin
QBIT_PASS=

MUSIC_DIR=/music
DOWNLOADS_DIR=/downloads
COVERS_DIR=/covers

# Proton VPN for qBittorrent (gluetun). Paid plan, WireGuard config with NAT-PMP (port forwarding) on.
WIREGUARD_PRIVATE_KEY=
# Proton servers to use (comma-separated); nearby countries are faster.
VPN_COUNTRIES=Austria,Italy,Hungary,Croatia,Switzerland,Germany
