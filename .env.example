# Copy to .env and adjust. Hostnames are the docker compose service names.
DATABASE_URL=postgresql+asyncpg://varsis:varsis@db:5432/varsis
POSTGRES_PASSWORD=varsis
SECRET_KEY=change-me-to-a-long-random-string
APP_URL=http://localhost:8080

# Dev: Mailpit catches all mail (UI on :8025). Prod: put real SMTP values here.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=varsis@localhost
SMTP_TLS=false

PROWLARR_URL=http://prowlarr:9696
PROWLARR_API_KEY=
QBIT_URL=http://qbittorrent:8081
QBIT_USER=admin
QBIT_PASS=

MUSIC_DIR=/music
DOWNLOADS_DIR=/downloads
COVERS_DIR=/covers
